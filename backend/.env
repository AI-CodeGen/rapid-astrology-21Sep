PORT=4000
NODE_ENV=development

# MongoDB connection string (in docker-compose we use the mongo service name)
# For complete docker env URL -> MONGO_URI=mongodb://mongo:27017/rapid_astrology
# For local dev setup URL ->
MONGO_URI=mongodb://localhost:27017/rapid_astrology

# JWT secret used to sign auth tokens (use a long random string in production)
JWT_SECRET=replace_me

# OTP expiry in minutes
OTP_EXPIRY_MINUTES=5

# Google OAuth credentials (create at https://console.cloud.google.com/ )
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# PayU sandbox credentials & base URL (switch BASE_URL for production)
PAYU_MERCHANT_KEY=your_payu_key
PAYU_MERCHANT_SALT=your_payu_salt
PAYU_BASE_URL=https://test.payu.in

# Frontend origin for CORS + OAuth redirect handling
FRONTEND_URL=http://localhost:5173

# 32 char key for potential report encryption / signing (placeholder)
REPORT_ENCRYPTION_KEY=change_this_32_char_key_here_1234

# Redis connection URL for caching numerology calculations (optional)
# For complete docker env URL -> REDIS_URL=redis://redis:6379
# For local dev setup URL ->
REDIS_URL=redis://localhost:6379

# Cache TTL seconds for numerology results
CACHE_TTL_SECONDS=3600

# Public backend base URL (used for payment callbacks construction)
BACKEND_PUBLIC_URL=http://localhost:4000